{
  "schemaVersion": 1,
  "minEngineVersion": 1,
  "id": "dark_card",
  "name": "暗夜卡",
  "canvas": {
    "width": 1080,
    "height": null,
    "padding": {
      "left": 72,
      "top": 64,
      "right": 72,
      "bottom": 64
    },
    "background": {
      "type": "image",
      "useCover": true,
      "blur": 48,
      "scrim": {
        "color": "#000000",
        "opacity": 0.7
      },
      "scaleType": "centerCrop",
      "editable": {
        "id": "background",
        "order": 2,
        "label": "背景",
        "controls": [
          {
            "property": "source",
            "control": "image",
            "label": "从相册选择"
          },
          {
            "property": "visible",
            "control": "switch",
            "label": "显示背景"
          },
          {
            "property": "background",
            "control": "color",
            "label": "纯色背景",
            "allowTransparent": true
          },
          {
            "property": "scale",
            "control": "slider",
            "label": "缩放",
            "range": [
              1.0,
              2.0
            ]
          },
          {
            "property": "offset_x",
            "control": "slider",
            "label": "水平位置",
            "range": [
              -0.3,
              0.3
            ]
          },
          {
            "property": "offset_y",
            "control": "slider",
            "label": "垂直位置",
            "range": [
              -0.3,
              0.3
            ]
          }
        ]
      }
    },
    "songInfo": {
      "mode": "above"
    }
  },
  "defaults": {
    "color": "#F2F2F2",
    "size": 42,
    "lineSpacing": 32,
    "align": "center",
    "editable": {
      "id": "text",
      "order": 3,
      "label": "字体",
      "controls": [
        {
          "property": "font",
          "control": "font",
          "label": "字体"
        },
        {
          "property": "color",
          "control": "color",
          "label": "字体颜色"
        }
      ]
    }
  },
  "elements": [
    {
      "type": "spacer",
      "height": 32
    },
    {
      "type": "image",
      "role": "cover",
      "useCover": true,
      "width": 420,
      "height": 420,
      "x": "center",
      "circle": true,
      "shadow": {
        "radius": 28,
        "dy": 10,
        "color": "#000000",
        "opacity": 0.4
      },
      "editable": {
        "id": "cover",
        "order": 1,
        "label": "封面",
        "controls": [
          {
            "property": "source",
            "control": "image",
            "label": "从相册选择"
          },
          {
            "property": "visible",
            "control": "switch",
            "label": "显示封面"
          },
          {
            "property": "shape",
            "control": "shape",
            "label": "形状"
          },
          {
            "property": "scale",
            "control": "slider",
            "label": "大小",
            "range": [
              0.6,
              1.4
            ]
          },
          {
            "property": "offset_x",
            "control": "slider",
            "label": "水平位置",
            "range": [
              -0.25,
              0.25
            ]
          },
          {
            "property": "offset_y",
            "control": "slider",
            "label": "垂直位置",
            "range": [
              -0.25,
              0.25
            ]
          }
        ]
      }
    },
    {
      "type": "text",
      "role": "title",
      "text": "{title}",
      "size": 48,
      "color": "#FFFFFF",
      "align": "center",
      "marginTop": 48
    },
    {
      "type": "text",
      "role": "artists",
      "text": "{artists}",
      "size": 30,
      "color": "#FFFFFF",
      "align": "center",
      "marginTop": 10
    },
    {
      "type": "lyric",
      "size": 42,
      "color": "#F0F0F0",
      "align": "center",
      "lineSpacing": 34,
      "marginTop": 64
    },
    {
      "type": "qrcode",
      "width": 132,
      "height": 132,
      "x": "center",
      "marginTop": 72,
      "qr": {
        "errorCorrection": "Q",
        "quietZone": 1,
        "backgroundColor": "#FFFFFF"
      },
      "editable": {
        "id": "qr",
        "order": 4,
        "label": "二维码",
        "controls": [
          {
            "property": "visible",
            "control": "switch",
            "label": "显示二维码"
          },
          {
            "property": "placement",
            "control": "enum",
            "label": "放置位置",
            "options": [
              "skin",
              "left",
              "center",
              "right"
            ]
          },
          {
            "property": "color",
            "control": "color",
            "label": "二维码颜色"
          },
          {
            "property": "background",
            "control": "color",
            "label": "底色",
            "allowTransparent": true
          },
          {
            "property": "scale",
            "control": "slider",
            "label": "大小",
            "range": [
              0.5,
              2.0
            ]
          }
        ]
      }
    }
  ]
}
