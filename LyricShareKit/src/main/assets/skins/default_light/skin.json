{
  "schemaVersion": 1,
  "minEngineVersion": 1,
  "id": "default_light",
  "name": "默认",
  "canvas": {
    "width": 1080,
    "height": null,
    "padding": {
      "left": 72,
      "top": 96,
      "right": 72,
      "bottom": 72
    },
    "background": {
      "type": "color",
      "color": "#FFFFFF",
      "editable": {
        "id": "background",
        "order": 2,
        "label": "背景",
        "controls": [
          {
            "property": "source",
            "control": "image",
            "label": "从相册选择"
          },
          {
            "property": "visible",
            "control": "switch",
            "label": "显示背景"
          },
          {
            "property": "background",
            "control": "color",
            "label": "纯色背景",
            "allowTransparent": true
          },
          {
            "property": "scale",
            "control": "slider",
            "label": "缩放",
            "range": [
              1.0,
              2.0
            ]
          },
          {
            "property": "offset_x",
            "control": "slider",
            "label": "水平位置",
            "range": [
              -0.3,
              0.3
            ]
          },
          {
            "property": "offset_y",
            "control": "slider",
            "label": "垂直位置",
            "range": [
              -0.3,
              0.3
            ]
          }
        ]
      }
    },
    "songInfo": {
      "mode": "above"
    }
  },
  "defaults": {
    "color": "#1A1A1A",
    "size": 44,
    "lineSpacing": 30,
    "letterSpacing": 0,
    "align": "left",
    "editable": {
      "id": "text",
      "order": 3,
      "label": "字体",
      "controls": [
        {
          "property": "font",
          "control": "font",
          "label": "字体"
        },
        {
          "property": "color",
          "control": "color",
          "label": "字体颜色"
        }
      ]
    }
  },
  "elements": [
    {
      "type": "image",
      "role": "cover",
      "useCover": true,
      "width": 936,
      "height": 936,
      "x": "center",
      "cornerRadius": 24,
      "shadow": {
        "radius": 20,
        "dx": 0,
        "dy": 8,
        "color": "#000000",
        "opacity": 0.15
      },
      "editable": {
        "id": "cover",
        "order": 1,
        "label": "封面",
        "controls": [
          {
            "property": "source",
            "control": "image",
            "label": "从相册选择"
          },
          {
            "property": "visible",
            "control": "switch",
            "label": "显示封面"
          },
          {
            "property": "shape",
            "control": "shape",
            "label": "形状"
          },
          {
            "property": "scale",
            "control": "slider",
            "label": "大小（最大 100%）",
            "range": [
              0.6,
              1.0
            ]
          },
          {
            "property": "offset_x",
            "control": "slider",
            "label": "水平位置",
            "range": [
              -0.25,
              0.25
            ]
          },
          {
            "property": "offset_y",
            "control": "slider",
            "label": "垂直位置",
            "range": [
              -0.25,
              0.25
            ]
          }
        ]
      }
    },
    {
      "type": "text",
      "role": "title",
      "text": "{title}",
      "size": 52,
      "color": "#111111",
      "marginTop": 48
    },
    {
      "type": "text",
      "role": "artists",
      "text": "{artists}",
      "size": 34,
      "color": "#111111",
      "marginTop": 12
    },
    {
      "type": "lyric",
      "size": 44,
      "color": "#333333",
      "lineSpacing": 30,
      "marginTop": 44
    },
    {
      "type": "qrcode",
      "width": 156,
      "height": 156,
      "x": "center",
      "marginTop": 56,
      "color": "#111111",
      "qr": {
        "errorCorrection": "M",
        "quietZone": 0,
        "backgroundColor": "#FFFFFF"
      },
      "editable": {
        "id": "qr",
        "order": 5,
        "label": "二维码",
        "controls": [
          {
            "property": "visible",
            "control": "switch",
            "label": "显示二维码"
          },
          {
            "property": "placement",
            "control": "enum",
            "label": "放置位置",
            "options": [
              "skin",
              "left",
              "center",
              "right"
            ]
          },
          {
            "property": "color",
            "control": "color",
            "label": "二维码颜色"
          },
          {
            "property": "background",
            "control": "color",
            "label": "底色",
            "allowTransparent": true
          },
          {
            "property": "scale",
            "control": "slider",
            "label": "大小",
            "range": [
              0.5,
              2.0
            ]
          }
        ]
      }
    }
  ]
}
